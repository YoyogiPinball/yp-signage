<monitors version="2">
  <!-- X13 サイネージ用ディスプレイ構成（GNOME/Mutter 保存先: ~/.config/monitors.xml）

       これは実機からの写し（2026-07-25 取得）。正本は実機側で、GNOME が随時上書きする。
       編集したいときは X13 の［設定］→［ディスプレイ］で操作し、結果をここへ吸い上げる:
         scp x13:~/.config/monitors.xml ~/Batches/x13/host/gnome/monitors.xml
       逆向き（ここから実機へ上書き）はしないこと。実機にしか無い構成を消すと画面の向きを見失う。
       deploy.sh でも自動配布しない。

       方針: 外部モニタ(縦)を常に論理原点(0,0)に固定し、蓋の開閉で位置がぶれないようにする。
       これで蓋を閉じて eDP-1 が切れても外部モニタは縦のまま、MagicMirror(窓 x:0)も載り続ける。

       コネクタ名は挿し替えで変わるため決め打ちにしない。2026-07-25 時点の外部モニタは HDMI-2。
       DP-2 の構成が残っているのは以前 DisplayPort に挿していた名残で、現在は未接続。
       GNOME は「今つながっているコネクタの組み合わせ」に一致する構成を自動で選ぶので、
       両方が同居していても害はない。 -->
  <configuration>
    <layoutmode>logical</layoutmode>
    <logicalmonitor>
      <x>0</x>
      <y>0</y>
      <scale>1</scale>
      <primary>yes</primary>
      <transform>
        <rotation>right</rotation>
        <flipped>no</flipped>
      </transform>
      <monitor>
        <monitorspec>
          <connector>HDMI-2</connector>
          <vendor>GSM</vendor>
          <product>22MP56</product>
          <serial>0x0005cc60</serial>
        </monitorspec>
        <mode>
          <width>1920</width>
          <height>1080</height>
          <rate>60.000</rate>
        </mode>
      </monitor>
    </logicalmonitor>
    <logicalmonitor>
      <x>117</x>
      <y>1920</y>
      <scale>1.25</scale>
      <monitor>
        <monitorspec>
          <connector>eDP-1</connector>
          <vendor>BOE</vendor>
          <product>0x07eb</product>
          <serial>0x00000000</serial>
        </monitorspec>
        <mode>
          <width>1920</width>
          <height>1080</height>
          <rate>60.000</rate>
        </mode>
      </monitor>
    </logicalmonitor>
  </configuration>
