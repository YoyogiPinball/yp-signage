# magicmirror/.env のテンプレート。
# このファイル(.example)はコミットする。実体の .env は .gitignore 済みでコミットしない。
#
# 使い方: このファイルを .env にコピーし、値を実物に差し替える。
#   cp .env.example .env
# 表示機では ~/MagicMirror/.env に置く（MagicMirror のルート = 起動時のカレントディレクトリ）。
#
# 書式は「KEY=値」だけ。引用符もカンマも要らない。行を書き損じても、その項目が
# 既定値に落ちるだけで他の設定は生き残る（config.js に直書きしていた頃と違い、
# 1文字のミスで画面全体が落ちることはない）。
#
# 値を空にした項目・行ごと消した項目は、下に書いた既定値で動く。
#
# 【優先順位】コマンド行で渡した環境変数 > この .env > config.js の既定値。
#   process.loadEnvFile() は既にある環境変数を上書きしないため、
#   `SIGNAGE_OSHI_COLS=3 bash ~/run/mm-start.sh` のような一時上書きが常に勝つ。
#
#   ただしコマンド行から届くのは mm-start.sh が引き渡す変数だけ（同スクリプトの
#   OVERRIDABLE に列挙。SIGNAGE_DEMO / SIGNAGE_OSHI_COLS / SIGNAGE_OSHI_NOW /
#   SIGNAGE_ORDER_MODE / SIGNAGE_REPEAT_MODE / SIGNAGE_IMAGE_DIR / SIGNAGE_SLIDE_INTERVAL / SIGNAGE_LOG_PATH）。
#   それ以外はこのファイルを書き換えて変える。

# ── デモモード ────────────────────────────────────────────
# true にすると、何も用意していなくても完成した画面が出る。
#   背景     … 同梱の samples/ の画像（SIGNAGE_IMAGE_DIR は無視される）
#   配信予定 … 通信せず、それらしい予定をその場で組み立てる
#   天気     … API キー不要のデモ用パネルに差し替わる
# 入れた直後の動作確認と、スクリーンショットを撮るときに使う。
SIGNAGE_DEMO=false

# ── 機能のオン/オフ ───────────────────────────────────────
# 使わないと決めた機能はここで false にする。URL や API キーを消しても止まるが、
# それだと「次に何を入れていたか」が残らない。値は残したまま止められるようにしてある。
SIGNAGE_OSHICAL_ENABLED=true
SIGNAGE_WEATHER_ENABLED=true

# ── 秘密情報 ──────────────────────────────────────────────
# 配信予定として読み込む iCal(ICS) フィードの URL。Google カレンダーの
# 「限定公開URL(iCal形式)」でも、ICS を吐ける他のサービスでもよい。
# URL を知っていれば予定を読めるトークン付き URL になるため、この .env に置く。
# 空のままだと「配信予定」バーそのものを出さない（起動は止めない）。
# 作者は自作の配信予定管理（推しスケ）が吐く ICS を繋いでいる:
#   https://<推しスケのホスト>/api/ical/<カレンダーID>
SIGNAGE_CALENDAR_ICS=

# 天気（OpenWeatherMap 無料API）。空の間は天気パネルを出さない（起動は止めない）。
# 取得: https://openweathermap.org/ で登録 → API keys の Default キーをコピー。
SIGNAGE_OWM_API_KEY=

# ── 設置場所 ──────────────────────────────────────────────
# 天気を出す地域の緯度経度。未設定なら東京(35.681, 139.767)。
SIGNAGE_WEATHER_LAT=35.681
SIGNAGE_WEATHER_LON=139.767

# ── 画面 ──────────────────────────────────────────────────
# 表示するモニターの解像度。縦置きなら幅より高さが大きくなる。
SIGNAGE_WIDTH=1080
SIGNAGE_HEIGHT=1920

# MagicMirror が待ち受けるポート。既定 8080。
SIGNAGE_PORT=8080

# ── スライドショー ────────────────────────────────────────
# 画像フォルダ。サブフォルダまで再帰で拾う。
# 空なら ~/signage/slides。`~` はここでは展開されないので、書くなら絶対パスで。
SIGNAGE_IMAGE_DIR=

# 表示中の画像を残すログ。画面を見て「これ壊れてる」と思ったとき犯人を引くためのもの。
# 空なら ~/signage/r5-now.log。書くなら絶対パスで。
SIGNAGE_LOG_PATH=

# 1枚あたりの表示時間(ミリ秒)。60000 = 60秒。
SIGNAGE_SLIDE_INTERVAL=60000

# 切替時のフェード時間(ミリ秒)。
SIGNAGE_FADE_SPEED=1200

# 表示順。sequential = ファイル名の自然順（2.jpg が 10.jpg より先）で出す。
# shuffle = 順番を混ぜる。混ぜた順は一巡のあいだ変わらないので、「前へ」は必ず直前の1枚に戻る。
SIGNAGE_ORDER_MODE=shuffle

# 最後の画像まで来たときの動き。
#   all  … 先頭へ戻って繰り返す（既定）
#   none … そこで自動送りを終える。画面は最後の画像のまま止まる
#   one  … 自動送りでは画像を変えない。1枚を出しっぱなしにする（手動の次へ・前へは動く）
SIGNAGE_REPEAT_MODE=all

# 【廃止予定】以前の設定。上の2項目をどちらも書かなかったときだけ読む。
#   true  → SIGNAGE_ORDER_MODE=shuffle    と同じ
#   false → SIGNAGE_ORDER_MODE=sequential と同じ
# どちらの場合も末尾では先頭へ戻る（SIGNAGE_REPEAT_MODE=all 相当）。
# 上の2項目を片方だけ書いた場合、この行は読まずに無視する（起動時に警告が出る）。
# 新旧が半分ずつ効いている状態を作らないため。新しい設定へ書き換えたら、この行は消してよい。
#SIGNAGE_SHUFFLE=true

# ── 配信予定 ──────────────────────────────────────────────
# 下部「配信予定」の列数。3 か 4（既定4）。列数×5行が表示上限になる。
# 一時的に変えたいだけなら .env を書き換えず `SIGNAGE_OSHI_COLS=3 bash ~/run/mm-start.sh` でよい。
SIGNAGE_OSHI_COLS=4
